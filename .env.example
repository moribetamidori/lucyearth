# Existing public Supabase configuration (safe for authentication in the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never use NEXT_PUBLIC_ for any values below.
SUPABASE_SERVICE_ROLE_KEY=

# AWS S3 image storage. The bucket/CDN must allow public reads, and S3 CORS
# must allow PUT requests from the app origin (see README.md).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BASE_URL=
AWS_S3_KEY_PREFIX=lucyearth

TRADE_ADMIN_EMAIL=
TRADE_APP_ORIGIN=http://localhost:3000
TRADING_MODE=paper
BROKER_PROVIDER=simulated
# Generate these in Webull's SANDBOX Developer Center, not production.
WEBULL_PAPER_APP_KEY=
WEBULL_PAPER_APP_SECRET=
# Use Discover accounts in /trade, then pin the desired sandbox account here.
WEBULL_PAPER_ACCOUNT_ID=
# Optional, only when the sandbox API key requires a verified token.
WEBULL_PAPER_ACCESS_TOKEN=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
# Set LLM_PROVIDER=anthropic and LLM_MODEL to a supported Claude model to use this.
ANTHROPIC_API_KEY=
# Immutable to agents. Only the operator can change these server settings.
MAX_ORDER_NOTIONAL=100
MAX_POSITION_PERCENT=1
MAX_TOTAL_EXPOSURE=2
MAX_DAILY_LOSS=25
MAX_OPEN_POSITIONS=2
MAX_TRADES_PER_DAY=4
ALLOWED_SYMBOLS=SPY,QQQ

# Laurie MVP (/laurie). Leave as demo for a credential-free, local-journal flow.
# webull_sandbox requires the existing Supabase/Webull/OpenAI values above,
# a confirmed TRADE_ADMIN_EMAIL operator, and the Laurie SQL migration.
LAURIE_MODE=demo
LAURIE_SYMBOL=SPY
# auto uses read-only Webull sandbox history when the app key/secret and
# one-minute market-data permission are available; sample forces offline data.
LAURIE_MARKET_DATA=auto
OPENJEV_API_KEY=

# PCEA route map (/pcea). Server key: enable "Routes API" and "Geocoding API"
# (restrict by API, not by referrer). Browser key: enable "Maps JavaScript API" and
# "Places API (New)" (location autocomplete when adding an event), and restrict it
# to your site's HTTP referrers. Optional Map ID for styling.
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
